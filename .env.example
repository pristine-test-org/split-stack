# Copy to .env and adjust. Nothing here is secret.

# Backend (read by uvicorn and seed.py). Relative paths are relative to backend/.
DATABASE_PATH=data/app.db
# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false
# Where the built SPA lives; the backend serves it when it exists.
# FRONTEND_DIST=../frontend/dist

# Frontend dev server (vite.config.ts): where /api is proxied to.
API_URL=http://localhost:8000
